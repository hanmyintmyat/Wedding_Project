# Prisma Postgres pooled TCP connection for runtime requests; SSL required.
DATABASE_URL=
# Prisma Postgres direct TCP connection for CLI, migrations, Studio and seed.
# CLI, migrations, Studio and seed require DIRECT_URL; no DATABASE_URL fallback.
DIRECT_URL=
# Generate with: openssl rand -base64 48
AUTH_SECRET=
# NextAuth v4 uses NEXTAUTH_URL; set both URLs to the same HTTPS domain.
NEXTAUTH_URL=
NEXT_PUBLIC_SITE_URL=
# Public Vercel Blob store connected to this project.
BLOB_READ_WRITE_TOKEN=
# No default admin credentials. Required for initial login and seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
